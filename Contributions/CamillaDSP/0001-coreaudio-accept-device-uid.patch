-use objc2_core_foundation::CFString;
+use objc2_core_foundation::{CFRetained, CFString};
 
 use audio_thread_priority::{
     demote_current_thread_from_real_time, promote_current_thread_to_real_time,
@@ -119,10 +120,38 @@ fn release_ownership(device_id: AudioDeviceID) -> Res<()> {
     Ok(())
 }
 
-/// Find the device id for a device name and scope (input or output).
+fn get_device_uid(device_id: AudioDeviceID) -> Option<String> {
+    let property_address = AudioObjectPropertyAddress {
+        mSelector: kAudioDevicePropertyDeviceUID,
+        mScope: kAudioObjectPropertyScopeGlobal,
+        mElement: kAudioObjectPropertyElementMain,
+    };
+    let mut device_uid: *const CFString = null();
+    let data_size = mem::size_of::<*const CFString>() as u32;
+    let status = unsafe {
+        AudioObjectGetPropertyData(
+            device_id,
+            NonNull::from(&property_address),
+            0,
+            null(),
+            NonNull::from(&data_size),
+            NonNull::from(&mut device_uid).cast(),
+        )
+    };
+    if status != kAudioHardwareNoError {
+        return None;
+    }
+    let device_uid = NonNull::new(device_uid as *mut CFString)?;
+    Some(unsafe { CFRetained::from_raw(device_uid) }.to_string())
+}
+
+/// Find the device id for a Core Audio UID or device name and scope (input or output).
 /// Some devices are listed as two device ids with the same name,
 /// where one supports playback and the other capture.
-pub fn get_device_id_from_name_and_scope(name: &str, input: bool) -> Option<AudioDeviceID> {
+pub fn get_device_id_from_identifier_and_scope(
+    identifier: &str,
+    input: bool,
+) -> Option<AudioDeviceID> {
     let scope = match input {
         false => Scope::Output,
         true => Scope::Input,
@@ -131,7 +160,8 @@ pub fn get_device_id_from_name_and_scope(name: &str, input: bool) -> Option<Audi
         return all_ids
             .iter()
             .find(|id| {
-                get_device_name(**id).unwrap_or_default() == name
+                (get_device_uid(**id).as_deref() == Some(identifier)
+                    || get_device_name(**id).unwrap_or_default() == identifier)
                     && get_audio_device_supports_scope(**id, scope).unwrap_or_default()
             })
             .copied();
@@ -182,8 +212,14 @@ pub fn list_device_names(input: bool) -> Vec<String> {
 }
 
 pub fn list_available_devices(input: bool) -> Vec<(String, String)> {
-    let names = list_device_names(input);
-    names.iter().map(|n| (n.clone(), n.clone())).collect()
+    get_audio_device_ids()
+        .unwrap_or_default()
+        .iter()
+        .filter(|device_id| device_supports_scope(**device_id, input))
+        .filter_map(|device_id| {
+            Some((get_device_uid(*device_id)?, get_device_name(*device_id).ok()?))
+        })
+        .collect()
 }
 
 fn device_supports_scope(device_id: u32, input: bool) -> bool {
@@ -229,7 +265,7 @@ fn open_coreaudio_playback(
             "Available playback devices: {:?}.",
             list_device_names(false)
         );
-        match get_device_id_from_name_and_scope(name, false) {
+        match get_device_id_from_identifier_and_scope(name, false) {
             Some(dev) => dev,
             None => {
                 let msg = format!("Could not find playback device '{name}'");
@@ -316,7 +352,7 @@ fn open_coreaudio_capture(
 ) -> Res<(AudioUnit, AudioDeviceID)> {
     let device_id = if let Some(name) = devname {
         debug!("Available capture devices: {:?}.", list_device_names(true));
-        match get_device_id_from_name_and_scope(name, true) {
+        match get_device_id_from_identifier_and_scope(name, true) {
             Some(dev) => dev,
             None => {
                 let msg = format!("Could not find capture device '{name}'.");
